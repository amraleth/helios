@inline fn sum(i8 a, i8 b): i8 {
   return a + b;
}

// this is another comment
fn test() (void, (err, message)?) {
   let x = sum(10, 10);
   if (x == 100) {
      printf("100 it is!");
   } else {
     printf("Hmh");
   }
}